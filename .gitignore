# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
out/

# ModDevGradle / Loom
run/
runs/
run-data/
.neoforge/
remappedSrc/

# Generated resources are committed on purpose (runData checks for drift),
